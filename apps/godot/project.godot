; Engine configuration file.
; Godot 4.7 .NET desktop app for the CS373 Course Timetabling Lab.

config_version=5

[application]

config/name="CS373 Room Map"
config/description="Weekly vs fixed room assignment, week by week."
run/main_scene="res://Main.tscn"
run/low_processor_mode=true
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/min_width=1200
window/size/min_height=720

[dotnet]

project/assembly_name="TimetablingRoomMap"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.937, 0.973, 0.969, 1)
